            }
          ]
        },
        "options": {}
      },
      "id": "c1c09151-7d2f-5132-8572-eb712c626774",
      "name": "Supplier Clear",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1140,
        120
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c107d668-4fcb-5985-82b6-1aec8126620b",
              "name": "result",
              "value": "={{ $json.message ?? 'Several companies fit this name. Run the check again with a registration number or LEI.' }}",
              "type": "string"
            },
            {
              "id": "4f5815e1-b5d9-56a4-b2e7-920bffb0cd16",
