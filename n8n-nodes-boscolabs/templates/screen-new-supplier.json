      "typeVersion": 2.2,
      "position": [
        920,
        20
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c3876bb2-8426-50e1-90cc-165571ed1fec",
              "name": "alert",
              "value": "={{ 'Supplier check needs attention: ' + $json.company.legal_name + ' (' + $json.summary.fail + ' fail, ' + $json.summary.review + ' review)' }}",
              "type": "string"
            },
            {
              "id": "d23d5050-2712-5147-8117-a2c533c5f315",
              "name": "details",
              "value": "={{ $json.checks.filter(c => ['fail', 'review'].includes(c.status)).map(c => c.check + ': ' + c.status + '. ' + c.detail + (c.source_url ? ' Source: ' + c.source_url : '')).join('\\n') }}",
              "type": "string"
            },
            {
              "id": "b65930bf-bdb5-5ecb-8bd1-f660b7fe5a82",
              "name": "unverified_checks",
              "value": "={{ $json.summary.unverified_checks.join(', ') }}",
              "type": "string"
            },
            {
              "id": "2148c3f2-147e-56a3-9dba-9d15e4663fb7",
              "name": "source_url",
              "value": "={{ $json.source_url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ec73d197-73e9-5716-96b3-7764873e16e1",
      "name": "Build Alert",
