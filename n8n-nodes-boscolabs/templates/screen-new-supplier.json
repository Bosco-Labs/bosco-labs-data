              "value": "={{ ($json.candidates ?? []).map(c => [c.legal_name, c.country, c.registration_number ?? c.lei].filter(Boolean).join(' / ')).join('\\n') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ea74f6a3-73df-5fe5-9cc7-3eedb2177063",
